
// Assets/Scripts/AR/ARModelLoader.cs
using System.Collections.Generic;
using UnityEngine;
using UnityEngine.EventSystems;
using UnityEngine.UI;
using UnityEngine.XR.ARFoundation;
using UnityEngine.XR.ARSubsystems;
using Unity.XR.CoreUtils;

#if ENABLE_INPUT_SYSTEM
using UnityEngine.InputSystem;
using UnityEngine.InputSystem.EnhancedTouch;
#endif

public class ARModelLoader : MonoBehaviour
{
    [Header("AR Managers (assign from scene)")]
    public XROrigin xrOrigin;
    public ARRaycastManager raycastManager;
    public ARPlaneManager planeManager;        // optional
    public ARCameraManager arCameraManager;    // optional

    [Header("Model Loading")]
    public Transform modelParent;              // e.g., XROrigin.transform
    public Material transparentMaterial;       // optional
    public GameObject currentModel;            // NOTE: this will be the ROOT wrapper

    [Header("Placement & Alignment")]
    public bool tapToPlaceEnabled = true;
    public float rotateSpeed = 40f;            // degrees/sec
    public float scaleStep = 0.02f;            // per tap

    [Header("Spawn Tuning")]
    [Tooltip("If your CAD is in millimeters (STEP exports often are), keep this at 0.001. If your model is already meters, set to 1.")]
    public float baseScale = 0.001f;

    [Tooltip("Target visible size in meters when spawning (helps auto-fit to camera).")]
    public float targetSizeMeters = 0.25f;     // ~25 cm

    [Tooltip("Extra padding multiplier for camera fit distance.")]
    public float fitPadding = 1.25f;

    // Internal
    private static readonly List<ARRaycastHit> s_Hits = new List<ARRaycastHit>();
    private Camera arCamera;

    void Awake()
    {
        if (xrOrigin == null)        xrOrigin        = Object.FindFirstObjectByType<XROrigin>();
        if (raycastManager == null)  raycastManager  = Object.FindAnyObjectByType<ARRaycastManager>();
        if (planeManager == null)    planeManager    = Object.FindAnyObjectByType<ARPlaneManager>();
        if (arCameraManager == null) arCameraManager = Object.FindAnyObjectByType<ARCameraManager>();

        arCamera = (xrOrigin != null && xrOrigin.Camera != null) ? xrOrigin.Camera : Camera.main;

        if (modelParent == null && xrOrigin != null) modelParent = xrOrigin.transform;

#if ENABLE_INPUT_SYSTEM
        EnhancedTouchSupport.Enable();
#endif

        if (xrOrigin == null)       Debug.LogError("[ARModelLoader] Missing XROrigin in scene.");
        if (raycastManager == null) Debug.LogWarning("[ARModelLoader] Missing ARRaycastManager (tap-to-place disabled).");
        if (arCamera == null)       Debug.LogWarning("[ARModelLoader] No AR camera found. Assign XR Origin camera or tag MainCamera.");
    }

    void OnDestroy()
    {
#if ENABLE_INPUT_SYSTEM
        EnhancedTouchSupport.Disable();
#endif
    }

    void Update()
    {
        if (currentModel == null) return;
        if (!tapToPlaceEnabled) return;

        // ------------ Input handling (New Input System OR Legacy) ------------

#if ENABLE_INPUT_SYSTEM
        // Touch
        if (UnityEngine.InputSystem.EnhancedTouch.Touch.activeTouches.Count > 0)
        {
            var t = UnityEngine.InputSystem.EnhancedTouch.Touch.activeTouches[0];
            if (t.phase == UnityEngine.InputSystem.TouchPhase.Began)
            {
                Vector2 pos = t.screenPosition;
                if (!IsPointerOverUI(pos)) TryPlaceAt(pos);
            }
        }

        // Mouse (Editor/desktop)
        if (Mouse.current != null && Mouse.current.leftButton.wasPressedThisFrame)
        {
            Vector2 pos = Mouse.current.position.ReadValue();
            if (!IsPointerOverUI(pos)) TryPlaceAt(pos);
        }

        // Rotation hotkeys
        if (Keyboard.current != null)
        {
            if (Keyboard.current.qKey.isPressed) currentModel.transform.Rotate(Vector3.up, -rotateSpeed * Time.deltaTime, Space.World);
            if (Keyboard.current.eKey.isPressed) currentModel.transform.Rotate(Vector3.up,  rotateSpeed * Time.deltaTime, Space.World);
        }
#else
        // Legacy touch
        if (Input.touchCount > 0)
        {
            var touch = Input.GetTouch(0);
            if (touch.phase == TouchPhase.Began && !IsPointerOverUI(touch.position))
                TryPlaceAt(touch.position);
        }

#if UNITY_EDITOR
        // Legacy mouse (Editor)
        if (Input.GetMouseButtonDown(0))
        {
            var pos = (Vector2)Input.mousePosition;
            if (!IsPointerOverUI(pos)) TryPlaceAt(pos);
        }

        // Legacy rotation keys
        if (Input.GetKey(KeyCode.Q)) currentModel.transform.Rotate(Vector3.up, -rotateSpeed * Time.deltaTime, Space.World);
        if (Input.GetKey(KeyCode.E)) currentModel.transform.Rotate(Vector3.up,  rotateSpeed * Time.deltaTime, Space.World);
#endif
#endif
    }

    /// <summary>
    /// Called when a GLTF/GLB has been instantiated.
    /// This version wraps the model in a ROOT, recenters by renderer bounds,
    /// and spawns it at a distance that fits the camera view.
    /// </summary>
    public void SetCurrentModel(GameObject go)
    {
        if (go == null) { Debug.LogError("[ARModelLoader] SetCurrentModel received null."); return; }

        // Destroy previous root
        if (currentModel != null) Destroy(currentModel);

        // Create wrapper root so we can recenter mesh without breaking placement
        var root = new GameObject(go.name + "_Root");
        if (modelParent != null)
            root.transform.SetParent(modelParent, false);

        // Parent the loaded model under root
        go.transform.SetParent(root.transform, false);

        // Apply transparency to the CHILD model renderers (not root)
        ApplyTransparentMaterial(go);

        // Recenter child so its bounds center sits at root origin
        RecenterChildToBounds(go, root.transform);

        // Auto-scale + spawn in front of camera so it is visible immediately
        SpawnRootFitToView(root.transform);

        // Keep reference to ROOT
        currentModel = root;

        Debug.Log("[ARModelLoader] Model assigned, recentered, and spawned in view.");
    }

    /// <summary>
    /// Tap-to-place: Planes + feature points, then fallback virtual plane.
    /// Moves the ROOT (currentModel).
    /// </summary>
    public void TryPlaceAt(Vector2 screenPos)
    {
        if (currentModel == null || raycastManager == null || arCamera == null)
            return;

        s_Hits.Clear();

        // Planes + feature points
        var types = TrackableType.PlaneWithinPolygon | TrackableType.FeaturePoint;
        if (raycastManager.Raycast(screenPos, s_Hits, types))
        {
            var hitPose = s_Hits[0].pose;
            currentModel.transform.SetPositionAndRotation(hitPose.position, hitPose.rotation);
            Debug.Log("[ARModelLoader] Placed on trackable at " + hitPose.position);
            return;
        }

        // Fallback plane 0.5m in front of camera
        var ray = arCamera.ScreenPointToRay(screenPos);
        var plane = new Plane(arCamera.transform.forward,
                              arCamera.transform.position + arCamera.transform.forward * 0.5f);

        if (plane.Raycast(ray, out var enter))
        {
            var pos = ray.GetPoint(enter);
            currentModel.transform.position = pos;
            currentModel.transform.rotation = Quaternion.LookRotation(arCamera.transform.forward, Vector3.up);
            Debug.Log("[ARModelLoader] Fallback placement at " + pos);
        }
    }

    // UI hooks (operate on ROOT)
    public void RotateLeft()
    {
        if (currentModel) currentModel.transform.Rotate(Vector3.up, -rotateSpeed * Time.deltaTime * 10f, Space.World);
    }

    public void RotateRight()
    {
        if (currentModel) currentModel.transform.Rotate(Vector3.up, rotateSpeed * Time.deltaTime * 10f, Space.World);
    }

    public void ScaleUp()
    {
        if (currentModel) currentModel.transform.localScale += Vector3.one * scaleStep;
    }

    public void ScaleDown()
    {
        if (!currentModel) return;
        var s = currentModel.transform.localScale - Vector3.one * scaleStep;
        currentModel.transform.localScale = Vector3.Max(s, Vector3.one * 0.01f);
    }

    // Block ONLY interactive UI (Buttons/Toggles/Inputs/etc.)
    private bool IsPointerOverUI(Vector2 screenPos)
    {
        if (EventSystem.current == null) return false;

        var ed = new PointerEventData(EventSystem.current) { position = screenPos };
        var results = new List<RaycastResult>();
        EventSystem.current.RaycastAll(ed, results);

        foreach (var r in results)
        {
            var go = r.gameObject;
            if (go.GetComponent<Button>()     != null) return true;
            if (go.GetComponent<Toggle>()     != null) return true;
            if (go.GetComponent<InputField>() != null) return true;
            if (go.GetComponent<Slider>()     != null) return true;
            if (go.GetComponent<Scrollbar>()  != null) return true;
        }
        return false;
    }

    private void ApplyTransparentMaterial(GameObject go)
    {
        if (transparentMaterial == null) return;

        var renderers = go.GetComponentsInChildren<Renderer>(true);
        foreach (var r in renderers)
        {
            var mats = r.sharedMaterials;
            for (int i = 0; i < mats.Length; i++)
                mats[i] = new Material(transparentMaterial);
            r.sharedMaterials = mats;
        }
    }

    // -------------------- NEW: Bounds recenter + camera fit --------------------

    private void RecenterChildToBounds(GameObject childModel, Transform root)
    {
        var renderers = childModel.GetComponentsInChildren<Renderer>(true);
        if (renderers == null || renderers.Length == 0) return;

        Bounds b = renderers[0].bounds;
        for (int i = 1; i < renderers.Length; i++)
            b.Encapsulate(renderers[i].bounds);

        // Move the child so bounds center aligns with root origin
        Vector3 localCenter = root.InverseTransformPoint(b.center);
        childModel.transform.localPosition -= localCenter;
    }

    private void SpawnRootFitToView(Transform root)
    {
        if (arCamera == null)
            arCamera = (xrOrigin != null && xrOrigin.Camera != null) ? xrOrigin.Camera : Camera.main;

        if (arCamera == null) return;

        // Get bounds after recentering (renderers under root)
        var renderers = root.GetComponentsInChildren<Renderer>(true);
        if (renderers == null || renderers.Length == 0) return;

        Bounds b = renderers[0].bounds;
        for (int i = 1; i < renderers.Length; i++)
            b.Encapsulate(renderers[i].bounds);

        float maxSize = Mathf.Max(b.size.x, b.size.y, b.size.z);
        if (maxSize < 0.00001f) maxSize = 0.01f;

        // Scale so the model's largest dimension is ~targetSizeMeters
        float scaleFactor = targetSizeMeters / maxSize;
        root.localScale = Vector3.one * (baseScale * scaleFactor);

        // Distance so it fits within camera vertical FOV
        float radius = targetSizeMeters * 0.5f;
        float fovRad = arCamera.fieldOfView * Mathf.Deg2Rad;
        float dist = (radius / Mathf.Tan(fovRad * 0.5f)) * fitPadding;

        dist = Mathf.Max(dist, arCamera.nearClipPlane + 0.25f);

        root.position = arCamera.transform.position + arCamera.transform.forward * dist;
        root.rotation = Quaternion.LookRotation(arCamera.transform.forward, Vector3.up);
    }
}
